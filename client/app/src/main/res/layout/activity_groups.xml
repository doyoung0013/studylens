<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:text="스터디 그룹"
            style="@style/ScreenTitle"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCreateGroup"
                android:text="그룹 만들기"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:backgroundTint="#16A34A"/>

            <Button
                android:id="@+id/btnJoinGroup"
                android:text="초대 코드로 참여"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#111827"/>
        </LinearLayout>

        <TextView
            android:text="내 그룹"
            style="@style/SectionTitle"/>

        <LinearLayout
            android:id="@+id/groupContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvGroupsEmpty"
            android:text="아직 참여한 그룹이 없어요. 그룹을 만들거나 초대 코드로 참여해 보세요."
            style="@style/EmptyText"/>
    </LinearLayout>
</ScrollView>
