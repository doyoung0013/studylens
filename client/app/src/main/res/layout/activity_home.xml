<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F9FAFB"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:padding="20dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 1. Header -->
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:src="@drawable/ic_back"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                app:tint="#1F2937"/>

            <TextView
                android:text="12월 학습 현황"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#111827"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content" />

            <ImageView
                android:src="@drawable/ic_share"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                app:tint="#1F2937"/>
        </LinearLayout>

        <!-- 2. Status Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="#111827"
            app:cardCornerRadius="28dp"
            app:cardElevation="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="26dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:src="@drawable/ic_clock"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        app:tint="#4ADE80"/>

                    <TextView
                        android:text="오늘의 학습"
                        android:textColor="#F3F4F6"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextView
                        android:text="57"
                        android:textSize="52sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="/ 60분"
                        android:textSize="20sp"
                        android:textColor="#9CA3AF"
                        android:layout_marginStart="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:progress="95"
                    android:progressDrawable="@drawable/progress_custom"
                    android:progressTint="#4ADE80"
                    android:backgroundTint="#374151"
                    android:indeterminate="false"
                    android:max="100"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 3. Calendar Section -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Calendar Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:src="@drawable/ic_calendar"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        app:tint="#15803d"
                        android:background="#E8F5E9"
                        android:padding="6dp"/>

                    <TextView
                        android:text="Calendar"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:text="2025.12"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#15803d"
                        android:background="#DCFCE7"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- 요일 Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView android:text="일" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="12sp" android:textColor="#9CA3AF"/>
                    <TextView android:text="월" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="12sp" android:textColor="#9CA3AF"/>
                    <TextView android:text="화" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="12sp" android:textColor="#9CA3AF"/>
                    <TextView android:text="수" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="12sp" android:textColor="#9CA3AF"/>
                    <TextView android:text="목" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="12sp" android:textColor="#9CA3AF"/>
                    <TextView android:text="금" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="12sp" android:textColor="#9CA3AF"/>
                    <TextView android:text="토" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="12sp" android:textColor="#9CA3AF"/>
                </LinearLayout>

                <!-- ★ ID 부활: calendarGrid ★ -->
                <!-- 이 LinearLayout 안에 날짜들이 들어있으므로, 자바에서 탐색 가능합니다 -->
                <LinearLayout
                    android:id="@+id/calendarGrid"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Week 1 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="1" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:textColor="#4B5563"/></FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="2" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:background="@drawable/bg_day_active" android:textColor="#15803d" android:textStyle="bold"/></FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="3" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:background="@drawable/bg_day_active" android:textColor="#15803d" android:textStyle="bold"/></FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="4" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:background="@drawable/bg_day_active" android:textColor="#15803d" android:textStyle="bold"/></FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="5" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:textColor="#4B5563"/></FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="6" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:textColor="#4B5563"/></FrameLayout>
                    </LinearLayout>

                    <!-- Week 2 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="7" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:textColor="#4B5563"/></FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="8" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:textColor="#4B5563"/></FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="9" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:textColor="#4B5563"/></FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="10" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:background="@drawable/bg_day_active" android:textColor="#15803d" android:textStyle="bold"/></FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="11" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:background="@drawable/bg_day_active" android:textColor="#15803d" android:textStyle="bold"/></FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="12" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:textColor="#4B5563"/></FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="13" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:textColor="#4B5563"/></FrameLayout>
                    </LinearLayout>

                    <!-- Week 3 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="14" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:textColor="#4B5563"/></FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="15" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:background="@drawable/bg_day_active" android:textColor="#15803d" android:textStyle="bold"/></FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="16" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:background="@drawable/bg_day_active" android:textColor="#15803d" android:textStyle="bold"/></FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="17" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:textColor="#4B5563"/></FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="18" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:textColor="#4B5563"/></FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                            <TextView android:text="19" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:background="@drawable/bg_day_selected" android:textColor="#FFFFFF" android:textStyle="bold"/>
                        </FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="20" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:textColor="#4B5563"/></FrameLayout>
                    </LinearLayout>

                    <!-- Week 4 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="21" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:textColor="#4B5563"/></FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="22" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:textColor="#4B5563"/></FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="23" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:textColor="#4B5563"/></FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="24" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:textColor="#4B5563"/></FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="25" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:textColor="#EF4444" android:textStyle="bold"/></FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="26" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:textColor="#4B5563"/></FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="27" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:textColor="#4B5563"/></FrameLayout>
                    </LinearLayout>

                    <!-- Week 5 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="28" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:textColor="#4B5563"/></FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="29" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:textColor="#4B5563"/></FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="30" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:textColor="#4B5563"/></FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:text="31" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:layout_gravity="center" android:textColor="#4B5563"/></FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 4. Daily Report Card -->
        <include
            layout="@layout/component_daily_report"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- 5. Button -->
        <Button
            android:id="@+id/btnGallery"
            android:text="나의 공부 모습 보러가기"
            android:backgroundTint="#16A34A"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="40dp"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:elevation="4dp"
            android:stateListAnimator="@null"
            android:gravity="center"
            android:drawableEnd="@drawable/ic_back"
            android:drawableTint="#FFFFFF"
            android:paddingHorizontal="24dp"/>

    </LinearLayout>
</ScrollView>