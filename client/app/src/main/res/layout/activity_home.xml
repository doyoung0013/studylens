<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F9FAFB"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:padding="20dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 1. Header -->
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnPrevMonth"
                android:contentDescription="이전 달"
                android:src="@drawable/ic_back"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                app:tint="#1F2937"/>

            <TextView
                android:id="@+id/tvMonthTitle"
                android:text="학습 현황"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#111827"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content" />

            <ImageView
                android:id="@+id/btnNextMonth"
                android:contentDescription="다음 달"
                android:rotationY="180"
                android:src="@drawable/ic_back"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                app:tint="#1F2937"/>
        </LinearLayout>

        <!-- 1-1. 실시간 상태 (GET /api/study/current/) -->
        <LinearLayout
            android:id="@+id/liveStatusBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/rounded_white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <View
                android:id="@+id/liveDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/bg_live_idle"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLiveStatus"
                    android:text="상태 확인 중..."
                    android:textColor="#111827"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/tvLiveDetail"
                    android:text=""
                    android:textColor="#6B7280"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 2. 선택한 날짜의 학습 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="#111827"
            app:cardCornerRadius="28dp"
            app:cardElevation="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="26dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:src="@drawable/ic_clock"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        app:tint="#4ADE80"/>

                    <TextView
                        android:id="@+id/tvCardTitle"
                        android:text="오늘의 학습"
                        android:textColor="#F3F4F6"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <!-- 서버 연동 -->
                    <TextView
                        android:id="@+id/tvTodayMinutes"
                        android:text="0"
                        android:textSize="52sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvGoal"
                        android:text="분 순공부 / 목표 60분"
                        android:textSize="20sp"
                        android:textColor="#9CA3AF"
                        android:layout_marginStart="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- 서버 연동 -->
                <ProgressBar
                    android:id="@+id/progressToday"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:max="60"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_custom"
                    android:backgroundTint="#374151"/>

                <!-- 집중도 (전체 / 딴짓 / 집중도%) -->
                <TextView
                    android:id="@+id/tvFocusInfo"
                    android:text="전체 0분 · 딴짓 0분 · 집중도 -"
                    android:textColor="#9CA3AF"
                    android:textSize="13sp"
                    android:layout_marginTop="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 3. Calendar -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Calendar Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:src="@drawable/ic_calendar"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        app:tint="#15803d"
                        android:background="#E8F5E9"
                        android:padding="6dp"/>

                    <TextView
                        android:text="Calendar"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tvMonthBadge"
                        android:text=""
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#15803d"
                        android:background="#DCFCE7"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- 요일 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:text="일"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"/>

                    <TextView
                        android:text="월"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"/>

                    <TextView
                        android:text="화"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"/>

                    <TextView
                        android:text="수"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"/>

                    <TextView
                        android:text="목"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"/>

                    <TextView
                        android:text="금"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"/>

                    <TextView
                        android:text="토"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"/>

                </LinearLayout>

                <!-- 날짜 Grid -->
                <!-- 날짜 Grid: HomeActivity 가 선택한 달에 맞춰 동적으로 생성 -->
                <LinearLayout
                    android:id="@+id/calendarGrid"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnGallery"
            android:text="나의 공부 모습 보러가기"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="20dp"/>

        <!-- 4. 친구 / 스터디 그룹 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFriends"
                android:text="친구 랭킹"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:backgroundTint="#16A34A"/>

            <Button
                android:id="@+id/btnGroups"
                android:text="스터디 그룹"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#111827"/>
        </LinearLayout>

        <TextView
            android:id="@+id/btnLogout"
            android:text="로그아웃"
            android:textColor="#9CA3AF"
            android:padding="12dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
