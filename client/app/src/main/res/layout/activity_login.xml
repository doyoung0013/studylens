<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F9FAFB"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 1. Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="40dp">

            <!-- 로고 대신 텍스트 강조 -->
            <TextView
                android:text="Studylens"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#16A34A"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="Welcome Back!"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="오늘도 목표를 향해 달려보세요"
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- 2. Username 입력 (CardView로 둥근 배경 구현) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:text="Username"
                android:textColor="#374151"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:layout_marginLeft="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- 둥근 흰색 박스 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <!-- 테두리 효과를 위한 마진이 있는 내부 레이아웃이 없으므로 심플하게 그림자 없이 평면 스타일 적용하거나 -->
                <!-- 배경색을 흰색으로 하고 EditText 배경을 투명하게 설정 -->
                <EditText
                    android:id="@+id/username"
                    android:hint="아이디를 입력하세요"
                    android:textColor="#1F2937"
                    android:textColorHint="#9CA3AF"
                    android:textSize="15sp"
                    android:background="@null"
                    android:padding="18dp"
                    android:inputType="text"
                    android:maxLines="1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- 3. Password 입력 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="40dp">

            <TextView
                android:text="Password"
                android:textColor="#374151"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:layout_marginLeft="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <EditText
                    android:id="@+id/password"
                    android:hint="비밀번호를 입력하세요"
                    android:inputType="textPassword"
                    android:textColor="#1F2937"
                    android:textColorHint="#9CA3AF"
                    android:textSize="15sp"
                    android:background="@null"
                    android:padding="18dp"
                    android:maxLines="1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </androidx.cardview.widget.CardView>

            <TextView
                android:text="비밀번호를 잊으셨나요?"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:gravity="end"
                android:layout_marginTop="12dp"
                android:layout_marginRight="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- 4. Login 버튼 -->
        <!-- backgroundTint와 cornerRadius를 사용하여 drawable 없이 둥근 버튼 구현 -->
        <Button
            android:id="@+id/loginBtn"
            android:text="Login"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#16A34A"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="24dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="16dp"
            android:elevation="4dp"
            android:stateListAnimator="@null"/>

        <!-- 5. 회원가입 링크 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:text="계정이 없으신가요? "
                android:textColor="#6B7280"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/btnSignup"
                android:text="회원가입"
                android:textColor="#16A34A"
                android:textStyle="bold"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>