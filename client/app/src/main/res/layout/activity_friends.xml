<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:text="친구 랭킹"
            style="@style/ScreenTitle"/>

        <!-- 친구 추가 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/inputFriendUsername"
                android:hint="친구 아이디"
                android:inputType="text"
                android:layout_width="0dp"
                android:layout_weight="1"
                style="@style/FormInput"/>

            <Button
                android:id="@+id/btnAddFriend"
                android:text="요청"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#16A34A"/>
        </LinearLayout>

        <!-- 받은 요청 -->
        <TextView
            android:id="@+id/tvRequestsTitle"
            android:text="받은 친구 요청"
            style="@style/SectionTitle"/>

        <LinearLayout
            android:id="@+id/requestContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvRequestsEmpty"
            android:text="받은 요청이 없어요"
            style="@style/EmptyText"/>

        <!-- 랭킹 -->
        <TextView
            android:text="순공부 랭킹"
            style="@style/SectionTitle"/>

        <include layout="@layout/view_period_tabs"/>

        <LinearLayout
            android:id="@+id/rankingContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvRankingHint"
            android:text="친구를 길게 누르면 친구를 삭제할 수 있어요"
            style="@style/EmptyText"/>
    </LinearLayout>
</ScrollView>
