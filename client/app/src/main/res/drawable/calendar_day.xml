<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- 기본 배경색 -->
    <solid android:color="#F5F5F5" />

    <!-- 테두리 -->
    <stroke
        android:width="1dp"
        android:color="#DDDDDD" />

    <!-- 버튼 크기 제어 -->
    <size
        android:width="48dp"
        android:height="48dp" />

    <!-- 둥근 모서리 -->
    <corners android:radius="50dp" />

</shape>
