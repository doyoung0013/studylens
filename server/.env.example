# server/.env 로 복사해서 사용 (.env 는 git에 올라가지 않습니다)

# 운영에서는 반드시 길고 랜덤한 값으로 설정
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# 로컬 개발: 1 / 운영: 0
DJANGO_DEBUG=0

# 쉼표로 구분
DJANGO_ALLOWED_HOSTS=doyoung.pythonanywhere.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://doyoung.pythonanywhere.com

# (선택) 경로 변경
# DJANGO_DB_PATH=/home/you/studylens/server/db.sqlite3
# DJANGO_MEDIA_ROOT=/home/you/studylens/server/media

# (선택) 도메인 설정
# STUDYLENS_MAX_IMAGE_BYTES=5242880
# STUDYLENS_MAX_IMAGE_SIDE=1280
# STUDYLENS_IMAGE_URL_MAX_AGE=3600
# STUDYLENS_MAX_BACKDATE_SEC=86400
